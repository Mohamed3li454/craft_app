# ==============================================================================
# Craft Command Center Dashboard V2 — Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit production secrets or credentials to source control.
# - Supply production variables exclusively through your hosting provider's
#   secure environment configuration (e.g. Vercel, AWS SSM, Doppler).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY CONFIGURATION (Never exposed to the browser or client bundle)
# ------------------------------------------------------------------------------

# The internal URL of the Craft Express backend service (Node/BFF level only)
BACKEND_URL=http://localhost:3000

# The master administrative secret key.
# In production, must match the backend's ADMIN_SECRET_KEY.
# Keep empty in templates. Must be provided at deployment runtime.
ADMIN_SECRET_KEY=

# Dedicated session signing secret for HMAC-SHA256 cookie signatures.
# If omitted, the BFF falls back to ADMIN_SECRET_KEY.
# Keep empty in templates.
SESSION_SECRET=

# Session expiration duration in seconds (default: 86400 = 24 hours)
SESSION_MAX_AGE_SECONDS=86400

# Node environment mode: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE METADATA (Optional UI labels only — ZERO SECRETS)
# ------------------------------------------------------------------------------

# Optional environment label shown in UI topbar
NEXT_PUBLIC_APP_ENV=local-development
