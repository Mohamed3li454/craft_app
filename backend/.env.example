# ==============================================================================
# Craft AI Agent Platform — Backend Environment Configuration
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Supabase / PostgreSQL Database
# Example Pooler: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_PHONE_NUMBER_ID=1221939377680241
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=craft_secret_verify_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Security & Circuit Breakers
MAX_AGENT_ITERATIONS=5
TOOL_TIMEOUT_MS=8000
CONFIRMATION_EXPIRES_MINUTES=5
