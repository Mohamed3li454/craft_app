# ==============================================================================
# Craft AI Agent Platform — Backend Environment Configuration
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# AI Multi-Provider & Model Orchestration
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=
AI_MAX_PROVIDER_ATTEMPTS=2
AI_PROVIDER_TIMEOUT_MS=30000

# Groq High-Speed LPU Models (Primary LLM Engine)
GROQ_API_KEY=your_groq_api_key_here
# Optional comma-separated key pool for automatic round-robin & rate limit rotation:
# GROQ_API_KEYS=key1,key2,key3
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Supabase / PostgreSQL Database
# Example Pooler: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=craft_secret_verify_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Rate Limiting & VIP Access
DAILY_USER_MESSAGE_LIMIT=40
VIP_PHONE_NUMBERS=

# Search Tools (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

# Semantic Embedding Provider (mock, groq, openai, local)
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_MS=3000

# Security & Circuit Breakers
MAX_AGENT_ITERATIONS=5
TOOL_TIMEOUT_MS=8000
CONFIRMATION_EXPIRES_MINUTES=5

# Cron Security (Vercel Cron Authorization)
CRON_SECRET=your_cron_secret_here

# Admin Analytics Dashboard Secret Key
ADMIN_SECRET_KEY=craft_admin_2026
