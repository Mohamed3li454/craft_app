# Craft Mobile Client Environment Configuration

# 1. Backend Server Configuration (Recommended)
# When set, the mobile app communicates through the secure Craft AI Agent Backend API,
# ensuring zero secrets or API keys are exposed inside the Flutter binary.
BACKEND_BASE_URL=http://localhost:3000/api/v1

# 2. Local Standalone Fallback (Optional - for offline local development only)
# If BACKEND_BASE_URL is left empty, the app falls back to direct Gemini calls.
# WARNING: Never package release APK / IPA builds with production keys in assets/.env!
API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=your_tavily_api_key_here
